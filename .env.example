# --- Infrastructure (Used by Docker Compose) ---
DB_USER=postgres
DB_PASSWORD=mysecretpassword
DB_NAME=backit_db
DB_PORT=5432

REDIS_PORT=6379
REDIS_HOST=localhost

# --- Backend Application (Used by NestJS) ---
# Note: Inside Docker, the host is 'postgres', not 'localhost'
DATABASE_URL=postgresql://postgres:mysecretpassword@postgres:5432/backit_db
REDIS_URL=redis://redis:6379

# --- Stellar / Soroban ---
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
SOROBAN_RPC_URL="https://soroban-testnet.stellar.org"

# Oracle Signer (Off-chain ed25519)
# Use 'stellar keys generate' to get a real one for testing
ORACLE_SIGNER_SECRET="your stellar keys"

# Soroban Contracts
USDC_SAC_CONTRACT_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
RELAY_HOT_WALLET_SECRET="your relay hot wallet secret"

# --- Notifications / External Dispatcher ---
NOTIFICATION_WEBHOOK_URL="http://localhost:8080/webhook-receiver"

# --- Frontend Network Configuration (Used by Next.js, NEXT_PUBLIC_*) ---
# The frontend signs wallet transactions only when the connected wallet's
# network matches this deployment. `testnet`, `mainnet` and `futurenet` are
# supported. Contract IDs must be 56-char base32 Stellar contract IDs.
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
NEXT_PUBLIC_SOROBAN_RPC_URL="https://soroban-testnet.stellar.org"
NEXT_PUBLIC_HORIZON_URL="https://horizon-testnet.stellar.org"
NEXT_PUBLIC_CALL_REGISTRY_CONTRACT_ID=CALL_REGISTRY_CONTRACT_ID_PLACEHOLDER
NEXT_PUBLIC_OUTCOME_MANAGER_CONTRACT_ID=OUTCOME_MANAGER_CONTRACT_ID_PLACEHOLDER
NEXT_PUBLIC_USDC_SAC_CONTRACT_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA